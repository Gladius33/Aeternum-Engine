{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aeternum game pack API 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine_api",
    "id",
    "version",
    "name",
    "resources",
    "upgrades"
  ],
  "properties": {
    "engine_api": {
      "const": "1"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,63}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "initial_stock",
          "capacity",
          "amount",
          "interval_seconds"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/resourceId"
          },
          "initial_stock": {
            "$ref": "#/$defs/units"
          },
          "capacity": {
            "$ref": "#/$defs/units"
          },
          "amount": {
            "$ref": "#/$defs/units"
          },
          "interval_seconds": {
            "$ref": "#/$defs/interval"
          }
        }
      }
    },
    "upgrades": {
      "type": "array",
      "maxItems": 12800,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "resource",
          "level",
          "cost",
          "duration_seconds",
          "amount"
        ],
        "properties": {
          "resource": {
            "$ref": "#/$defs/resourceId"
          },
          "level": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "cost": {
            "type": "integer",
            "minimum": 1,
            "maximum": 1000000000000
          },
          "duration_seconds": {
            "$ref": "#/$defs/interval"
          },
          "amount": {
            "$ref": "#/$defs/units"
          }
        }
      }
    },
    "components": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "fields"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "fields": {
            "$ref": "#/$defs/fieldMap"
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "payload"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "payload": {
            "$ref": "#/$defs/fieldMap"
          }
        }
      }
    },
    "event_hooks": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "payload"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "payload": {
            "$ref": "#/$defs/fieldMap"
          }
        }
      }
    },
    "buildings": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "stages"
        ],
        "properties": {
          "type": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "stages": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "costs",
                "duration",
                "requires"
              ],
              "properties": {
                "costs": {
                  "type": "object",
                  "minProperties": 1,
                  "maxProperties": 16,
                  "propertyNames": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000000000000
                  }
                },
                "duration": {
                  "$ref": "#/$defs/interval"
                },
                "requires": {
                  "type": "object",
                  "maxProperties": 16,
                  "propertyNames": {
                    "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
                  },
                  "additionalProperties": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 16
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "resourceId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "units": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000000000000
    },
    "interval": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2592000
    },
    "fieldMap": {
      "type": "object",
      "maxProperties": 24,
      "propertyNames": {
        "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
      },
      "additionalProperties": {
        "enum": [
          "integer",
          "string",
          "boolean",
          "nullable_integer",
          "nullable_string",
          "nullable_boolean"
        ]
      }
    }
  },
  "$comment": "The PHP loader additionally enforces exact integer types, byte limits, uniqueness, valid resource references, feasible costs, construction prerequisite references, and contiguous upgrade levels. Optional building definitions are opt-in and immutable under world digest pinning."
}
