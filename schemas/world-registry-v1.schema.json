{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Aeternum operator-approved world registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "registry_api",
    "worlds"
  ],
  "properties": {
    "registry_api": {
      "const": "1"
    },
    "worlds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "world",
          "pack",
          "version",
          "sha256"
        ],
        "properties": {
          "world": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]{0,127}$"
          },
          "pack": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
          },
          "version": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.+-]{0,63}$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    }
  },
  "$comment": "PHP additionally checks file size, duplicate worlds, exact artifact path, actual SHA-256 bytes, matching id/version and blocked public configuration paths."
}
