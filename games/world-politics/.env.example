# World Politics — template only. Never commit .env or real credentials.
# Syntax is shell-compatible. PHP uses process environment (getenv), not dotenv.
# Copy to a protected file outside the public document roots; inject only the
# relevant variables into each service. Do NOT load this entire file in every web worker.

# Game API — disabled until explicitly enabled.
WP_ALPHA_ENABLED=NO
WP_ALPHA_LOOPBACK=NO
WP_DB_DSN='mysql:host=127.0.0.1;port=3306;dbname=world_politics;charset=utf8mb4'
WP_DB_USER=wp_game
WP_DB_PASSWORD=
# Independent random secrets (at least 32 characters; openssl rand -hex 32).
WP_ALPHA_INVITE=
WP_CAREER_EVIDENCE_KEY=

# Research API — separate database and restricted runtime user.
WP_RESEARCH_ENABLED=NO
WP_RESEARCH_LOOPBACK=NO
WP_RESEARCH_DB_DSN='mysql:host=127.0.0.1;port=3306;dbname=world_politics_research;charset=utf8mb4'
WP_RESEARCH_DB_USER=wp_research
WP_RESEARCH_DB_PASSWORD=
WP_RESEARCH_EVIDENCE_KEY=

# Optional dataset bridge — read-only game export credentials, independent signing key.
WP_DATASET_DB_DSN='mysql:host=127.0.0.1;port=3306;dbname=world_politics;charset=utf8mb4'
WP_DATASET_DB_USER=wp_dataset_reader
WP_DATASET_DB_PASSWORD=
WP_DATASET_BRIDGE_KEY=
# Enable only after the game data-use notice and release policy are approved.
# When enabled: all supported game worlds, regardless of player subscription.
WP_DATASET_AUTO_CAPTURE=NO
# Stable identifier for this physical game source; never reuse for a reset DB.
WP_DATASET_SOURCE_ID=world-politics-primary
WP_DATASET_SYNC_MAX_PAGES=100

# Operator-only gates. Keep NO in all long-running HTTP environments.
# Set YES only for the specific authorized CLI invocation.
WP_ALPHA_INSTALL=NO
WP_ALPHA_MAINTENANCE=NO
WP_BILLING_OPERATOR=NO
WP_RESEARCH_OPERATOR=NO
WP_DATASET_OPERATOR=NO
WP_REFERENCE_IMPORT=NO
WP_REVISION_CLERK=NO
WP_LEGISLATION_CLERK=NO
WP_CAMPAIGN_AUTHOR=NO
WP_CAREER_BALLOT_IMPORT=NO
WP_CAREER_CLOCK=NO
WP_CAREER_UNIVERSE_TICKS=NO
WP_UNIVERSE_TICKS=NO
WP_RELEASE_AUDIT=NO
WP_RESEARCH_TEST=NO

# Stripe — Research test-mode checkout and webhook; game Premium/Portal reserved.
# Live mode is blocked in code pending full settlement qualification.
WP_STRIPE_ENABLED=NO
WP_STRIPE_MODE=test
WP_STRIPE_CURRENCY=eur
WP_STRIPE_SECRET_KEY=
WP_STRIPE_PUBLISHABLE_KEY=
WP_STRIPE_WEBHOOK_SECRET=
WP_STRIPE_API_VERSION=2024-10-28.acacia
WP_STRIPE_PRICE_GAME_PREMIUM_MONTHLY=
WP_STRIPE_PRICE_RESEARCH_STANDARD_MONTHLY=
WP_STRIPE_PRICE_RESEARCH_PRO_MONTHLY=
WP_STRIPE_PRICE_RESEARCH_STANDARD_CREDITS=
WP_STRIPE_PRICE_RESEARCH_PRO_CREDITS=
# Plan allowances and credit pack quantities are pending commercial approval.
WP_STRIPE_STANDARD_INCLUDED_CREDITS=
WP_STRIPE_PRO_INCLUDED_CREDITS=
WP_STRIPE_STANDARD_PACK_CREDITS=
WP_STRIPE_PRO_PACK_CREDITS=
# Full HTTPS URLs, defined at deployment; no client-supplied redirect targets.
WP_STRIPE_SUCCESS_URL=
WP_STRIPE_CANCEL_URL=
WP_STRIPE_PORTAL_RETURN_URL=

# Dedicated operator accounts; no billing, normal scope and hard capacity caps.
# Generate each bearer independently (openssl rand -hex 32). Store its SHA-256
# digest here, not the bearer itself. Configure the matching create-admin ID.
WP_ADMIN_RESEARCH_ENABLED=NO
WP_ADMIN_RESEARCH_STANDARD_MONTHLY_TENANT=
WP_ADMIN_RESEARCH_STANDARD_MONTHLY_TOKEN_SHA256=
WP_ADMIN_RESEARCH_STANDARD_PAYG_TENANT=
WP_ADMIN_RESEARCH_STANDARD_PAYG_TOKEN_SHA256=
WP_ADMIN_RESEARCH_PRO_MONTHLY_TENANT=
WP_ADMIN_RESEARCH_PRO_MONTHLY_TOKEN_SHA256=
WP_ADMIN_RESEARCH_PRO_PAYG_TENANT=
WP_ADMIN_RESEARCH_PRO_PAYG_TOKEN_SHA256=
# Own game account, regular login/session and data token still required.
WP_ADMIN_GAME_ENABLED=NO
WP_ADMIN_GAME_ACCOUNT=
